# Konfiguracja Apache dla hostingu OVH (katalog www/).
# Plik jest wgrywany przez tools/deploy/deploy.py razem ze stroną.

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Przekierowania 301 na jeden adres: https://plaszowska25.pl/
  # (www -> bez www, http -> https). OVH rozpoznaje http po porcie 80.
  # Adres testowy *.hosting.ovh.net nie jest przekierowywany.
  RewriteCond %{HTTP_HOST} ^www\.plaszowska25\.pl$ [NC,OR]
  RewriteCond %{SERVER_PORT} 80
  RewriteCond %{HTTP_HOST} ^(www\.)?plaszowska25\.pl$ [NC]
  RewriteRule ^(.*)$ https://plaszowska25.pl/$1 [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # Adres testowy OVH (*.hosting.ovh.net) i inne nazwy poza domeną: bez indeksowania
  SetEnvIfNoCase Host ^plaszowska25\.pl$ P25_PROD
  Header set X-Robots-Tag "noindex, nofollow" env=!P25_PROD

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  # CSS/JS są wersjonowane (?v=...), zdjęcia rzadko się zmieniają
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>

AddType application/manifest+json .webmanifest
AddType image/webp .webp
